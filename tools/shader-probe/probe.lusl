// Offline shader feasibility probe in LUSL (docs/development/tools/shader-probe.md). One source
// lowers to Slang, which emits SPIR-V 1.3 stages, WGSL and, through SPIRV-Cross, GLSL ES 3.00.
// The upload contract is the std140 block below; uniform_layout.h mirrors it on the CPU.
struct ProbeUniforms
{
    float32x2 Resolution;
    float32 ElapsedTime;
    float32x3 Direction;
    float32x4 Tint;
};
ConstantBuffer<ProbeUniforms> probe;

struct ProbeVarying
{
    float32x4 Position : ClipPosition;
};

// The vertex index lowers to the plain Vulkan VertexIndex / WGSL vertex_index / GLSL ES
// gl_VertexID. Base-vertex semantics (SPV_KHR_shader_draw_parameters) would be rejected by
// SPIRV-Cross for the WebGL 2 (GLSL ES) backend. The non-indexed, zero-base-vertex fullscreen
// draw makes these identical in value for every backend.
[stage(vertex)]
ProbeVarying VertexMain(in uint32 vertexIndex : VertexIndex)
{
    float32x2 p = float32x2(float32((vertexIndex << 1) & 2), float32(vertexIndex & 2));
    ProbeVarying output = { .Position = float32x4(p * 2.0 - 1.0, 0.0, 1.0) };
    return output;
}

[stage(fragment)]
float32x4 FragmentMain(in ProbeVarying input)
{
    // A fragment reads the ClipPosition field as its pixel position, top-left origin.
    float32x2 positionPixel = input.Position.xy;
#if LUDUS_GLSL_ES
    // WebGL fragment coordinates start at the bottom; the authored scene uses top-left pixels.
    positionPixel.y = probe.Resolution.y - positionPixel.y;
#endif
    float32x2 uv = positionPixel / probe.Resolution;
    float32x2 centered = (positionPixel - probe.Resolution * 0.5) / probe.Resolution.y;
    float32 circle = dot(centered, centered) < 0.04 ? 1.0 : 0.0;
    float32 pulse = 0.05 * probe.ElapsedTime;
    return float32x4(probe.Tint.rgb * float32x3(uv.x, uv.y, circle) + probe.Direction * pulse, probe.Tint.a);
}
