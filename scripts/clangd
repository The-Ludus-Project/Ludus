#!/usr/bin/env bash
set -euo pipefail
script_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
python_command="$script_dir/../out/host-tools/venv/bin/python"
# A Python upgrade can leave the managed interpreter unable to start; use the
# system Python then (./init.sh rebuilds the environment).
if ! "$python_command" -c 'import encodings' >/dev/null 2>&1; then python_command=python3; fi
exec "$python_command" "${script_dir}/python/editor_setup.py" clangd "$@"
