#!/usr/bin/env python3
"""Compare saved Ludus HDR captures or two display images and write an offline HTML report."""
from __future__ import annotations

import argparse
from base64 import b64encode
from dataclasses import dataclass
from html import escape
from io import BytesIO
import json
import math
from pathlib import Path
from string import Template
import sys
from typing import TYPE_CHECKING

if TYPE_CHECKING:
    from numpy import ndarray

SCRIPT_DATA = Path(__file__).resolve().parent / 'python'
sys.path.insert(0, str(SCRIPT_DATA))
from capture_hdr import GRAPH_MAGIC, HEADER_BYTES, REFERENCE_MAGIC, decode

LUMINANCE = (0.2126, 0.7152, 0.0722)
CHUNK_PIXELS = 65536
DISPLAY_MAXIMUM = 255
UNSAMPLED_GREY = 64


@dataclass
class ImageInput:
    path: Path
    size: tuple[int, int]
    metadata: dict
    rgb: ndarray
    samples: ndarray | None = None

    @property
    def is_linear(self):
        return self.samples is not None


def read_image(path, np, Image, ImageCms, ImageOps):
    try:
        with path.open('rb') as source:
            header = source.read(29)
            source.seek(0)
            if header[:8] in (GRAPH_MAGIC, REFERENCE_MAGIC) or path.suffix.lower() in ('.luhdr', '.lurgcap'):
                data = source.read()
                metadata, _ = decode(data, keep_pixels=False)
                records = np.frombuffer(data, dtype=[('rgb', '<f4', (3,)), ('samples', '<u4')],
                                        offset=HEADER_BYTES)
                metadata.setdefault('kind', 'rt1_reference')
                return ImageInput(path, (metadata['width'], metadata['height']), metadata,
                                  records['rgb'], records['samples'])
            with Image.open(source, formats=['PNG', 'JPEG', 'WEBP']) as original:
                if getattr(original, 'n_frames', 1) != 1:
                    raise ValueError('export the frame you want to compare as a still PNG')
                if original.format == 'PNG' and header[24] > 8:
                    raise ValueError('export an 8-bit sRGB PNG for display comparison')
                image = ImageOps.exif_transpose(original)
                rgba = image.convert('RGBA')
                profile = image.info.get('icc_profile')
                if profile:
                    color = image
                    if image.mode == 'LA':
                        color = image.getchannel('L')
                    elif image.mode not in ('RGB', 'L', 'CMYK'):
                        color = rgba.convert('RGB')
                    rgb = ImageCms.profileToProfile(color, BytesIO(profile),
                                                    ImageCms.createProfile('sRGB'), outputMode='RGB')
                    alpha = rgba.getchannel('A')
                    rgba = rgb.convert('RGBA')
                    rgba.putalpha(alpha)
                elif image.mode == 'CMYK':
                    raise ValueError('export the untagged CMYK image as sRGB')
                rgb = Image.alpha_composite(Image.new('RGBA', image.size, (0, 0, 0, 255)), rgba).convert('RGB')
                metadata = {
                    'kind': original.format,
                    'color_profile': 'ICC converted to sRGB' if profile else 'sRGB assumed',
                    'alpha_background': 'black',
                }
                return ImageInput(path, image.size, metadata, np.asarray(rgb).reshape(-1, 3))
    except (OSError, ValueError, Image.DecompressionBombError, ImageCms.PyCMSError) as error:
        raise ValueError(f'{path}: {error}') from error


def describe_captures(baseline, candidate):
    warnings = []
    for role, image in (('Baseline', baseline), ('Candidate', candidate)):
        metadata = image.metadata
        if metadata.get('failed') or metadata.get('partial'):
            state = 'failed' if metadata.get('failed') else 'partial'
            warnings.append(f'{role} capture is {state}. Its metrics are diagnostic.')
    if not baseline.is_linear:
        return warnings
    first, second = baseline.metadata, candidate.metadata
    for field in ('camera_position', 'world_to_clip'):
        if any(not math.isclose(a, b, rel_tol=1e-5, abs_tol=1e-6) for a, b in zip(first[field], second[field])):
            warnings.append('Capture cameras differ. Check alignment before interpreting the pixel errors.')
            break
    for field in ('scene_identity', 'scene_fingerprint'):
        if field in first and field in second and first[field] != second[field]:
            warnings.append('Capture scene identities differ.')
    if first['kind'] != second['kind'] and any(m.get('center_rays') is False for m in (first, second)):
        warnings.append('The reference samples pixel footprints. Use Trace pixel centres to match a graph '
                        'that traces pixel centres.')
    return warnings


def compare(baseline, candidate, scale, np):
    """Measure candidate minus baseline over pixels present in both inputs."""
    total = len(baseline.rgb)
    compared = 0
    absolute = squared = relative = luminance = 0.0
    maximum = -1.0
    worst_pixel = 0
    heatmap = np.empty((total, 3), dtype=np.uint8)
    heatmap[:] = UNSAMPLED_GREY
    for start in range(0, total, CHUNK_PIXELS):
        region = slice(start, start + CHUNK_PIXELS)
        first = baseline.rgb[region]
        second = candidate.rgb[region]
        valid = slice(None)
        if baseline.is_linear:
            valid = (baseline.samples[region] > 0) & (candidate.samples[region] > 0)
        first = first[valid].astype(np.float64)
        second = second[valid].astype(np.float64)
        if not len(first):
            continue
        error = second - first
        if not baseline.is_linear:
            error /= DISPLAY_MAXIMUM
        magnitude = np.abs(error)
        pixel_error = magnitude.max(axis=1)
        local_worst = int(pixel_error.argmax())
        if pixel_error[local_worst] > maximum:
            maximum = float(pixel_error[local_worst])
            offset = np.flatnonzero(valid)[local_worst] if baseline.is_linear else local_worst
            worst_pixel = start + int(offset)
        error_squared = error * error
        compared += len(first)
        absolute += float(magnitude.sum())
        squared += float(error_squared.sum())
        luminance += float(np.sum(error * LUMINANCE))
        if baseline.is_linear:
            # Same relative error as the editor's reference_comparison.cpp, with thanks to
            # Rousselle, Knaus and Zwicker, "Adaptive Sampling and Reconstruction using Greedy
            # Error Minimization", ACM TOG 30(6), 2011, https://doi.org/10.1145/2070781.2024193.
            relative += float(np.sum(error_squared / (first * first + 0.01)))
        strength = np.minimum(pixel_error, scale) / scale
        heatmap[region][valid] = np.rint(strength[:, None] * (255, 128, 0)).astype(np.uint8)
    if not compared:
        raise ValueError('no pixels have committed samples in both captures. Let both captures render and save again.')
    channels = compared * 3
    mse = squared / channels
    width, height = baseline.size
    metrics = {
        'compared_pixels': compared, 'total_pixels': total, 'coverage': compared / total,
        'mae': absolute / channels, 'rmse': math.sqrt(mse), 'max_channel_error': maximum,
        'worst_pixel_xy': [worst_pixel % width, worst_pixel // width],
        'luminance_bias': luminance / compared,
    }
    if baseline.is_linear:
        metrics['relative_mse'] = relative / channels
    else:
        metrics['psnr_db'] = min(100.0, -10 * math.log10(mse)) if mse else 100.0
    return metrics, heatmap.reshape(height, width, 3)


def make_preview(image, np):
    if not image.is_linear:
        return image.rgb.reshape(image.size[1], image.size[0], 3)
    preview = np.full(image.rgb.shape, UNSAMPLED_GREY, dtype=np.uint8)
    for start in range(0, len(image.rgb), CHUNK_PIXELS):
        region = slice(start, start + CHUNK_PIXELS)
        valid = image.samples[region] > 0
        rgb = image.rgb[region][valid]
        compressed = rgb / (1 + rgb)
        srgb = np.where(compressed <= 0.0031308, 12.92 * compressed,
                        1.055 * compressed ** (1 / 2.4) - 0.055)
        preview[region][valid] = np.rint(srgb * DISPLAY_MAXIMUM).astype(np.uint8)
    return preview.reshape(image.size[1], image.size[0], 3)


def png_uri(pixels, Image):
    output = BytesIO()
    Image.fromarray(pixels).save(output, format='PNG')
    return 'data:image/png;base64,' + b64encode(output.getbuffer()).decode('ascii')


def format_metrics(metrics, is_linear):
    formatted = {
        'Compared pixels': f"{metrics['compared_pixels']:,} / {metrics['total_pixels']:,} ({metrics['coverage']:.2%})",
        'Mean absolute error': f"{metrics['mae']:.6g}",
        'Root mean square error': f"{metrics['rmse']:.6g}",
        'Largest channel error': f"{metrics['max_channel_error']:.6g} at ({', '.join(map(str, metrics['worst_pixel_xy']))})",
        'Signed luminance bias': f"{metrics['luminance_bias']:+.6g}",
    }
    if is_linear:
        formatted['Relative mean square error'] = f"{metrics['relative_mse']:.6g}"
    else:
        formatted['PSNR'] = f"{metrics['psnr_db']:.4g} dB"
    return ''.join(f'<div><dt>{label}</dt><dd>{value}</dd></div>' for label, value in formatted.items())


def write_report(path, report, baseline, results, np, Image):
    payload = json.dumps(report, indent=2, allow_nan=False)
    template = Template((SCRIPT_DATA / 'render_comparison.html').read_text(encoding='utf-8'))
    options = []
    entries = []
    for index, (candidate_path, comparison, preview, heatmap) in enumerate(results):
        label = escape(candidate_path.name)
        options.append(f'<option value="{index}">{label}</option>')
        notes = ''.join(f'<li>{escape(note)}</li>' for note in comparison['warnings'])
        metrics = format_metrics(comparison['metrics'], baseline.is_linear)
        entries.append(
            f'<template id="candidate-{index}"><span>{label}</span>'
            f'<img class="candidate-source" src="{preview}" alt="">'
            f'<img class="error-source" src="{heatmap}" alt="">'
            f'<ul>{notes}</ul><dl>{metrics}</dl></template>'
        )
    html = template.substitute(
        baseline=escape(baseline.path.name),
        width=baseline.size[0], height=baseline.size[1], scale=f"{report['heatmap_full_scale']:.6g}",
        space=report['comparison_space'],
        preview_note=('HDR previews compress radiance with x / (1 + x) before sRGB encoding.'
                      if baseline.is_linear else 'The previews show the sRGB values used for the metrics.'),
        baseline_image=png_uri(make_preview(baseline, np), Image),
        options=''.join(options), entries=''.join(entries),
        multi_candidate_only='hidden' if len(results) == 1 else '',
        metadata=escape(payload),
    )
    with path.open('x', encoding='utf-8') as output:
        output.write(html)


def analyze(baseline, candidate, scale, np):
    if baseline.is_linear != candidate.is_linear:
        raise ValueError(f'{candidate.path}: choose two linear captures or display images. For display comparisons, '
                         'use the PNG saved alongside the capture.')
    if baseline.size != candidate.size:
        raise ValueError(f'{candidate.path}: baseline is {baseline.size[0]}×{baseline.size[1]}, candidate is '
                         f'{candidate.size[0]}×{candidate.size[1]}. Capture or export both at the same resolution.')
    metrics, heatmap = compare(baseline, candidate, scale, np)
    return {
        'candidate': {'path': str(candidate.path), **candidate.metadata},
        'warnings': describe_captures(baseline, candidate),
        'metrics': metrics,
    }, heatmap


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('baseline', type=Path, help='expected image or reference capture')
    parser.add_argument('candidates', nargs='+', type=Path, help='images or captures to measure against the baseline')
    parser.add_argument('-o', '--output', required=True, type=Path, help='path for a new HTML report')
    parser.add_argument('--diff-scale', type=float, default=0.25,
                        help='absolute channel error that saturates the heatmap (default: 0.25)')
    args = parser.parse_intermixed_args()
    if not math.isfinite(args.diff_scale) or args.diff_scale <= 0:
        parser.error('--diff-scale must be finite and positive')
    if args.output.suffix.lower() != '.html':
        parser.error('--output must end in .html')
    try:
        import numpy as np
        from PIL import Image, ImageCms, ImageOps
    except ImportError:
        parser.error('install the analysis dependencies with python -m pip install numpy Pillow')
    try:
        baseline = read_image(args.baseline, np, Image, ImageCms, ImageOps)
        results = []
        for path in args.candidates:
            candidate = read_image(path, np, Image, ImageCms, ImageOps)
            comparison, heatmap = analyze(baseline, candidate, args.diff_scale, np)
            results.append((path, comparison, png_uri(make_preview(candidate, np), Image), png_uri(heatmap, Image)))
        report = {
            'comparison_space': 'scene-linear RGB' if baseline.is_linear else 'sRGB display values',
            'width': baseline.size[0], 'height': baseline.size[1], 'heatmap_full_scale': args.diff_scale,
            'baseline': {'path': str(baseline.path), **baseline.metadata},
        }
        if len(results) == 1:
            report.update(results[0][1])
        else:
            report['comparisons'] = [entry[1] for entry in results]
        write_report(args.output, report, baseline, results, np, Image)
    except FileExistsError:
        parser.error(f'{args.output} already exists. Choose a new report path.')
    except (OSError, ValueError) as error:
        parser.error(str(error))
    print(json.dumps(report, indent=2, allow_nan=False))


if __name__ == '__main__':
    main()
