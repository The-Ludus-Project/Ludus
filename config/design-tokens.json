{
  "version": 1,
  "description": "Single source of Ludus colour and spacing tokens. Read by the Qt editor (generated header at configure time), the init window (scripts/python/init_theme.py) and the browser editor (generated block in apps/editor/browser/editor.css; refresh it with scripts/python/design_tokens.py --write). Every pair in `contrast` is checked in both appearances by the editor tests and scripts/python/test_design_tokens.py. The `highContrast` colours replace the listed tokens when the system asks for more contrast (or LUDUS_HIGH_CONTRAST=1); each pair also holds its `highContrastMinimum` there. Every colour is in at least one pair or names why it is exempt in `contrastExempt` (decorative or inactive only); scripts/python/design_tokens.py rejects the file otherwise. `size` holds fixed control sizes in logical pixels. `type` holds font-size multipliers of the system font.",
  "colours": {
    "surface.workspace": {
      "dark": "#18232c",
      "light": "#f1efea",
      "use": "Window background and gaps between panels"
    },
    "surface.panel": {
      "dark": "#222f39",
      "light": "#ffffff",
      "use": "Docks, fields and lists"
    },
    "surface.raised": {
      "dark": "#2c3c47",
      "light": "#e6e3dc",
      "use": "Buttons, headers and hover"
    },
    "surface.viewport": {
      "dark": "#090c0f",
      "light": "#090c0f",
      "use": "3D viewport, texture viewer and graph canvas base; dark in both appearances so lighting judgements do not change with the UI theme"
    },
    "surface.viewportTop": {
      "dark": "#0f151b",
      "light": "#0f151b",
      "use": "Top of the Solid and Albedo viewport backdrop, a very subtle gradient down to surface.viewport; Lit keeps the scene background"
    },
    "surface.log": {
      "dark": "#111a21",
      "light": "#18232c",
      "use": "Setup log pane"
    },
    "text.primary": {
      "dark": "#e9f2f1",
      "light": "#18232c",
      "use": "Body text and values"
    },
    "text.secondary": {
      "dark": "#b5c5c9",
      "light": "#4c6267",
      "use": "Labels and descriptions"
    },
    "text.tertiary": {
      "dark": "#a5b7bc",
      "light": "#4f6468",
      "use": "Hints, units and captions"
    },
    "text.disabled": {
      "dark": "#71858c",
      "light": "#7f9195",
      "use": "Disabled text",
      "contrastExempt": "WCAG 1.4.3 and 1.4.11 exempt inactive controls; the editor palette draws disabled text in text.secondary, which is checked"
    },
    "text.log": {
      "dark": "#d7e3e2",
      "light": "#e9f2f1",
      "use": "Setup log text"
    },
    "text.hud": {
