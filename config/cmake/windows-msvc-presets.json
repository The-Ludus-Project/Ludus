{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/config/cmake/windows-msvc.cmake",
        "CMAKE_PREFIX_PATH": "$env{LUDUS_WINDOWS_DEPENDENCIES}",
        "LUDUS_ENABLE_CCACHE": "OFF",
        "LUDUS_BUILD_TESTS": "ON",
        "LUDUS_SLANG_COMPILER": "${sourceDir}/out/shader-tools/slang/bin/slangc.exe",
        "LUDUS_DXC_DIRECTORY": "${sourceDir}/out/shader-tools/dxc"
      }
    },
    {
      "name": "windows-msvc-ninja-base",
      "hidden": true,
      "inherits": "windows-msvc-base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-msvc-visual-studio",
      "displayName": "Windows MSVC (Visual Studio 2022)",
      "inherits": "windows-msvc-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64,version=10.0.26100.0",
      "toolset": "v143,version=14.44,host=x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}"
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug (Ninja)",
      "inherits": "windows-msvc-ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LUDUS_BUILD_FLAVOR": "Debug"
      }
    },
    {
      "name": "windows-msvc-development",
      "displayName": "Windows MSVC Development (Ninja)",
      "inherits": "windows-msvc-ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "LUDUS_BUILD_FLAVOR": "Development"
      }
    },
    {
      "name": "windows-msvc-asan",
      "displayName": "Windows MSVC Runtime AddressSanitizer (Ninja)",
      "inherits": "windows-msvc-runtime",
      "cacheVariables": {
        "LUDUS_ENABLE_ASAN": "ON",
        "LUDUS_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "windows-msvc-runtime",
      "displayName": "Windows MSVC Runtime (Ninja)",
      "inherits": "windows-msvc-development",
      "cacheVariables": {
        "LUDUS_BUILD_WINDOWS_RUNTIME": "ON",
        "LUDUS_BUILD_WORLD_DEMO": "ON",
        "LUDUS_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "windows-msvc-runtime-sdk",
      "displayName": "Windows MSVC Runtime SDK (Ninja)",
      "inherits": "windows-msvc-runtime",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "LUDUS_BUILD_TESTS": "OFF",
        "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "$<$<CONFIG:Debug,RelWithDebInfo>:Embedded>",
        "LUDUS_BUILD_WORLD_DEMO": "OFF",
        "LUDUS_BUILD_SMOKE_APP": "OFF"
      }
    },
    {
      "name": "windows-msvc-runtime-sdk-debug",
      "displayName": "Windows MSVC Runtime SDK Debug (Ninja)",
      "inherits": "windows-msvc-runtime-sdk",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LUDUS_BUILD_FLAVOR": "Debug"
      }
    },
    {
      "name": "windows-msvc-runtime-sdk-profile",
      "displayName": "Windows MSVC Runtime SDK Profile (Ninja)",
      "inherits": "windows-msvc-runtime-sdk",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "LUDUS_BUILD_FLAVOR": "Profile"
      }
    },
    {
      "name": "windows-msvc-runtime-sdk-release",
      "displayName": "Windows MSVC Runtime SDK Release (Ninja)",
      "inherits": "windows-msvc-runtime-sdk",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LUDUS_BUILD_FLAVOR": "Release"
      }
    },
    {
      "name": "windows-msvc-profile",
      "displayName": "Windows MSVC Profile (Ninja)",
      "inherits": "windows-msvc-ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "LUDUS_BUILD_FLAVOR": "Profile"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release (Ninja)",
      "inherits": "windows-msvc-ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LUDUS_BUILD_FLAVOR": "Release"
      }
    }
  ],
  "buildPresets": [
