{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 29,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-clang-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "environment": {
        "CONAN_HOME": "${sourceDir}/out/conan/home",
        "CONAN_NON_INTERACTIVE": "1",
        "PATH": "${sourceDir}/out/host-tools/bin:${sourceDir}/out/host-tools/venv/bin:$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "${sourceDir}/out/host-tools/bin/clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/out/host-tools/venv/bin/ninja",
        "LUDUS_BUILD_SMOKE_APP": "ON",
        "LUDUS_ENABLE_COVERAGE": "OFF",
        "LUDUS_ENABLE_TSAN": "OFF"
      }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux Clang Debug",
      "inherits": "linux-clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/out/conan/linux-clang-debug/conan_toolchain.cmake",
        "LUDUS_BUILD_TESTS": "ON",
        "LUDUS_ENABLE_ASAN": "OFF",
        "LUDUS_ENABLE_UBSAN": "OFF",
        "LUDUS_BUILD_FLAVOR": "Debug"
      }
    },
    {
      "name": "linux-clang-development",
      "displayName": "Linux Clang Development",
      "inherits": "linux-clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/out/conan/linux-clang-development/conan_toolchain.cmake",
        "LUDUS_BUILD_TESTS": "ON",
        "LUDUS_ENABLE_ASAN": "OFF",
        "LUDUS_ENABLE_UBSAN": "OFF",
        "LUDUS_BUILD_FLAVOR": "Development"
      }
    },
    {
      "name": "linux-clang-asan-ubsan",
      "displayName": "Linux Clang ASan UBSan",
      "inherits": "linux-clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/out/conan/linux-clang-asan-ubsan/conan_toolchain.cmake",
        "LUDUS_BUILD_TESTS": "ON",
        "LUDUS_ENABLE_ASAN": "ON",
        "LUDUS_ENABLE_UBSAN": "ON",
        "LUDUS_BUILD_FLAVOR": "Development"
      }
    },
    {
      "name": "linux-clang-profile",
      "displayName": "Linux Clang Profile",
      "inherits": "linux-clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/out/conan/linux-clang-profile/conan_toolchain.cmake",
        "LUDUS_BUILD_TESTS": "ON",
        "LUDUS_ENABLE_ASAN": "OFF",
        "LUDUS_ENABLE_UBSAN": "OFF",
        "LUDUS_COMPILED_LOG_LEVEL": "2",
        "LUDUS_BUILD_FLAVOR": "Profile"
      }
    },
    {
      "name": "linux-clang-release",
      "displayName": "Linux Clang Release",
      "inherits": "linux-clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/out/conan/linux-clang-release/conan_toolchain.cmake",
        "LUDUS_BUILD_TESTS": "OFF",
        "LUDUS_ENABLE_ASAN": "OFF",
        "LUDUS_ENABLE_UBSAN": "OFF",
        "LUDUS_BUILD_FLAVOR": "Release"
      }
    },
    {
      "name": "web-emscripten-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "toolchainFile": "${sourceDir}/out/host-tools/emsdk/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "environment": {
        "PATH": "${sourceDir}/out/host-tools/emsdk/upstream/emscripten:${sourceDir}/out/host-tools/venv/bin:$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/out/host-tools/venv/bin/ninja",
        "LUDUS_BUILD_TESTS": "OFF",
        "LUDUS_BUILD_SMOKE_APP": "ON",
        "LUDUS_WARNINGS_AS_ERRORS": "ON",
        "LUDUS_ENABLE_ASAN": "OFF",
        "LUDUS_ENABLE_UBSAN": "OFF",
        "LUDUS_ENABLE_TSAN": "OFF",
        "LUDUS_ENABLE_CCACHE": "OFF"
      }
    },
    {
      "name": "web-emscripten-development",
      "inherits": "web-emscripten-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "LUDUS_BUILD_FLAVOR": "Development"
      }
    },
    {
      "name": "web-emscripten-release",
      "inherits": "web-emscripten-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LUDUS_BUILD_FLAVOR": "Release"
      }
    },
    {
      "name": "macos-clang-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "environment": {
        "CONAN_HOME": "${sourceDir}/out/conan/home",
        "CONAN_NON_INTERACTIVE": "1",
        "PATH": "${sourceDir}/out/host-tools/bin:${sourceDir}/out/host-tools/venv/bin:$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "${sourceDir}/out/host-tools/bin/clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/out/host-tools/venv/bin/ninja",
        "LUDUS_BUILD_SMOKE_APP": "ON",
        "LUDUS_ENABLE_COVERAGE": "OFF",
        "LUDUS_ENABLE_TSAN": "OFF",
        "CMAKE_C_COMPILER": "${sourceDir}/out/host-tools/bin/clang",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0",
        "LUDUS_SPIRV_CROSS": "${sourceDir}/out/shader-tools/spirv-cross/bin/spirv-cross",
        "CMAKE_OSX_SYSROOT": "${sourceDir}/out/host-tools/macos-sdk",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++ -nostdinc++ -isystem \"${sourceDir}/out/host-tools/libcxx-include\"",
        "CMAKE_OBJCXX_COMPILER": "${sourceDir}/out/host-tools/bin/clang++",
        "CMAKE_OBJCXX_FLAGS": "-stdlib=libc++ -nostdinc++ -isystem \"${sourceDir}/out/host-tools/libcxx-include\""
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-clang-debug",
      "displayName": "macOS Clang Debug",
      "inherits": "macos-clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/out/conan/macos-clang-debug/conan_toolchain.cmake",
        "LUDUS_BUILD_TESTS": "ON",
        "LUDUS_ENABLE_ASAN": "OFF",
        "LUDUS_ENABLE_UBSAN": "OFF",
        "LUDUS_BUILD_FLAVOR": "Debug"
      }
    },
    {
      "name": "macos-clang-development",
      "displayName": "macOS Clang Development",
      "inherits": "macos-clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/out/conan/macos-clang-development/conan_toolchain.cmake",
        "LUDUS_BUILD_TESTS": "ON",
        "LUDUS_ENABLE_ASAN": "OFF",
        "LUDUS_ENABLE_UBSAN": "OFF",
        "LUDUS_BUILD_FLAVOR": "Development"
      }
    },
    {
      "name": "macos-clang-asan-ubsan",
      "displayName": "macOS Clang ASan UBSan",
      "inherits": "macos-clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/out/conan/macos-clang-asan-ubsan/conan_toolchain.cmake",
        "LUDUS_BUILD_TESTS": "ON",
        "LUDUS_ENABLE_ASAN": "ON",
        "LUDUS_ENABLE_UBSAN": "ON",
        "LUDUS_BUILD_FLAVOR": "Development"
      }
    },
    {
      "name": "macos-clang-profile",
      "displayName": "macOS Clang Profile",
      "inherits": "macos-clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/out/conan/macos-clang-profile/conan_toolchain.cmake",
        "LUDUS_BUILD_TESTS": "ON",
        "LUDUS_ENABLE_ASAN": "OFF",
        "LUDUS_ENABLE_UBSAN": "OFF",
        "LUDUS_COMPILED_LOG_LEVEL": "2",
        "LUDUS_BUILD_FLAVOR": "Profile"
      }
    },
    {
      "name": "macos-clang-release",
      "displayName": "macOS Clang Release",
      "inherits": "macos-clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/out/conan/macos-clang-release/conan_toolchain.cmake",
        "LUDUS_BUILD_TESTS": "OFF",
        "LUDUS_ENABLE_ASAN": "OFF",
        "LUDUS_ENABLE_UBSAN": "OFF",
        "LUDUS_BUILD_FLAVOR": "Release"
      }
    }
  ],
