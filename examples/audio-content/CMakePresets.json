{
  "version": 6,
  "configurePresets": [
    {"name": "native-debug", "generator": "Ninja", "binaryDir": "${sourceDir}/out/debug",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "CMAKE_CXX_COMPILER": "clang++-23", "CMAKE_PREFIX_PATH": "$env{LUDUS_SDK_DEBUG}"}},
    {"name": "native-development", "inherits": "native-debug", "binaryDir": "${sourceDir}/out/development",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo", "CMAKE_PREFIX_PATH": "$env{LUDUS_SDK_DEVELOPMENT}"}},
    {"name": "native-release", "inherits": "native-debug", "binaryDir": "${sourceDir}/out/release",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "CMAKE_PREFIX_PATH": "$env{LUDUS_SDK_RELEASE}"}}
  ],
  "buildPresets": [
    {"name": "native-debug", "configurePreset": "native-debug"},
    {"name": "native-development", "configurePreset": "native-development"},
    {"name": "native-release", "configurePreset": "native-release"}
  ],
  "testPresets": [
    {"name": "native-debug", "configurePreset": "native-debug", "output": {"outputOnFailure": true}},
    {"name": "native-development", "configurePreset": "native-development", "output": {"outputOnFailure": true}},
    {"name": "native-release", "configurePreset": "native-release", "output": {"outputOnFailure": true}}
  ]
}
