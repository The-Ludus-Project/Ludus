# Ludus coding standards enforcement. See AGENTS.md for the full rules.
#
# C++ exceptions are banned project-wide. This is enforced primarily by the
# compiler: engine code builds with -fno-exceptions (cmake/EngineOptions.cmake),
# so any throw / try / catch in engine code is a hard compile error.
# bugprone-std-exception-baseclass (enabled by bugprone-*; LLVM 23 removed its
# former hicpp-exception-baseclass alias) is an additional guard. Do not add
# exception-based error handling; use status codes / std::optional / return
# values instead.
#
# portability-avoid-pragma-once is off: `#pragma once` is the repository's
# header-guard convention (AGENTS.md "Formatting and static analysis"), and
# every supported compiler (Clang, Apple Clang, Emscripten) implements it.
#
# bugprone-signed-bitwise (new in LLVM 23) is off. On the macOS inventory it
# reported 348 sites; even ignoring positive literals, all 49 remaining were
# integer promotion of unsigned bytes (`uint8 << 8` widens to int) or POSIX,
# poll and FreeType flag macros that those C APIs define as signed int. None was
# a signedness defect, and silencing them needs casts that obscure byte codecs.
#
# bugprone-invalid-enum-default-initialization (new) stays on but misreports
# `Aggregate values[N]{}` as zero-initializing enum members that have default
# member initializers; such sites carry a NOLINT naming that limitation.
#
# readability-simplify-boolean-expr is deliberately off: the house style
# (AGENTS.md "Naming") writes `condition == false` and `condition == true`,
# which that check reports as redundant literals.
#
# Identifier naming is enforced per directory: modules that have adopted the
# AGENTS.md naming rules carry their own .clang-tidy with
# InheritParentConfig: true and readability-identifier-naming. See
# config/naming_scopes.txt and tools/check_naming.py for the text-level rules.
---
Checks: >
  -*,
  bugprone-*,
  -bugprone-chained-comparison,
  performance-*,
  portability-*,
  -portability-avoid-pragma-once,
  -bugprone-signed-bitwise,
  modernize-avoid-bind,
  modernize-use-default-member-init,
  modernize-use-nodiscard,
  modernize-use-nullptr,
  modernize-use-override,
  readability-avoid-const-params-in-decls,
  readability-braces-around-statements,
  readability-container-size-empty,
  readability-duplicate-include,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-redundant-control-flow,
  readability-redundant-member-init
WarningsAsErrors: ''
# Match whole directory components: an unanchored 'tools/' also matched
# out/host-tools/ (vendored libc++ headers on macOS).
HeaderFilterRegex: '(^|.*/)(modules|apps|tools|tests|examples)/.*'
FormatStyle: file
CheckOptions:
  - key: readability-braces-around-statements.ShortStatementLines
    value: '1'
