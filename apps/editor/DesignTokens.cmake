# Generates internal/design_tokens.h from config/design-tokens.json, the one source of colour, spacing and
# radius tokens shared with scripts/python/init_theme.py and browser/editor.css.
# Uses only CMake's string(JSON), so configuring needs neither Python nor cooked assets.

set(design_tokens_file "${PROJECT_SOURCE_DIR}/config/design-tokens.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${design_tokens_file}")
file(READ "${design_tokens_file}" design_tokens_json)

# "surface.workspace" -> "SurfaceWorkspace"; "accent.onPrimary" -> "AccentOnPrimary".
function(design_tokens_pascal_case name out_variable)
    string(REPLACE "." ";" parts "${name}")
    set(result "")
    foreach(part IN LISTS parts)
        string(SUBSTRING "${part}" 0 1 head)
        string(SUBSTRING "${part}" 1 -1 tail)
        string(TOUPPER "${head}" head)
        string(APPEND result "${head}${tail}")
    endforeach()
    set(${out_variable} "${result}" PARENT_SCOPE)
endfunction()

# "extraSmall" -> "EXTRA_SMALL".
function(design_tokens_upper_snake_case name out_variable)
    string(REGEX REPLACE "([a-z])([A-Z])" "\\1_\\2" snake "${name}")
    string(TOUPPER "${snake}" snake)
    set(${out_variable} "${snake}" PARENT_SCOPE)
endfunction()

# "#18232c" -> "0x18232c".
function(design_tokens_hex value out_variable)
    string(REPLACE "#" "0x" hex "${value}")
    set(${out_variable} "${hex}" PARENT_SCOPE)
endfunction()

string(JSON design_colour_count LENGTH "${design_tokens_json}" colours)
set(design_colour_enumerators "")
set(design_colour_definitions "")
set(design_colour_index_by_name "")
math(EXPR design_colour_last "${design_colour_count} - 1")
foreach(index RANGE ${design_colour_last})
    string(JSON name MEMBER "${design_tokens_json}" colours ${index})
    string(JSON dark GET "${design_tokens_json}" colours "${name}" dark)
    string(JSON light GET "${design_tokens_json}" colours "${name}" light)
    design_tokens_pascal_case("${name}" pascal)
    design_tokens_hex("${dark}" dark_hex)
    design_tokens_hex("${light}" light_hex)
    string(APPEND design_colour_enumerators "    ${pascal},\n")
    string(APPEND design_colour_definitions "    {\"${name}\", ${dark_hex}, ${light_hex}},\n")
    set(design_colour_index_${name} ${pascal})
endforeach()

string(JSON design_pair_count LENGTH "${design_tokens_json}" contrast)
set(design_contrast_definitions "")
math(EXPR design_pair_last "${design_pair_count} - 1")
foreach(index RANGE ${design_pair_last})
    string(JSON foreground GET "${design_tokens_json}" contrast ${index} foreground)
    string(JSON background GET "${design_tokens_json}" contrast ${index} background)
    string(JSON minimum GET "${design_tokens_json}" contrast ${index} minimum)
    string(JSON label GET "${design_tokens_json}" contrast ${index} label)
    design_tokens_pascal_case("${foreground}" foreground_pascal)
    design_tokens_pascal_case("${background}" background_pascal)
    if(NOT minimum MATCHES "\\.")
        set(minimum "${minimum}.0")
    endif()
    string(APPEND design_contrast_definitions
        "    {ThemeColour::${foreground_pascal}, ThemeColour::${background_pascal}, ${minimum}, \"${label}\"},\n")
endforeach()

set(design_scale_constants "")
foreach(group spacing radius)
    string(JSON member_count LENGTH "${design_tokens_json}" ${group})
    math(EXPR member_last "${member_count} - 1")
    string(TOUPPER "${group}" group_upper)
    foreach(index RANGE ${member_last})
        string(JSON member MEMBER "${design_tokens_json}" ${group} ${index})
        string(JSON value GET "${design_tokens_json}" ${group} "${member}")
        design_tokens_upper_snake_case("${member}" member_snake)
        string(APPEND design_scale_constants
            "/// ${group} token \"${member}\", in logical pixels.\ninline constexpr foundation::int32 ${group_upper}_${member_snake} = ${value};\n")
    endforeach()
endforeach()

set(design_tokens_directory "${CMAKE_CURRENT_BINARY_DIR}/design-tokens")
configure_file(src/internal/design_tokens.h.in "${design_tokens_directory}/design_tokens.h" @ONLY)
include_directories("${design_tokens_directory}")
