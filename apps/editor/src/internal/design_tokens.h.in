#pragma once

// Generated by apps/editor/DesignTokens.cmake from config/design-tokens.json. Edit the JSON, not this file.

#include <ludus/foundation/base/types.h>
#include <ludus/foundation/containers/static_array.hpp>

namespace ludus::editor::design
{
/// Number of colour tokens.
inline constexpr foundation::usize THEME_COLOUR_COUNT = @design_colour_count@;
/// Number of required contrast pairs.
inline constexpr foundation::usize CONTRAST_REQUIREMENT_COUNT = @design_pair_count@;

/// Colour roles, in the alphabetical order CMake enumerates the token file.
enum class ThemeColour : foundation::uint8
{
@design_colour_enumerators@};

/// One colour token with its value in each appearance, as 0xRRGGBB.
struct ThemeColourDefinition final
{
    const char* Name;
    foundation::uint32 Dark;
    foundation::uint32 Light;
};

/// A foreground that must keep at least Minimum:1 contrast against a background in both appearances.
struct ContrastRequirement final
{
    ThemeColour Foreground;
    ThemeColour Background;
    double Minimum;
    const char* Label;
};

/// Every colour token; index with static_cast<usize>(ThemeColour).
inline constexpr foundation::StaticArray<ThemeColourDefinition, THEME_COLOUR_COUNT> THEME_COLOURS{{
@design_colour_definitions@}};

/// Every required contrast pair.
inline constexpr foundation::StaticArray<ContrastRequirement, CONTRAST_REQUIREMENT_COUNT> CONTRAST_REQUIREMENTS{{
@design_contrast_definitions@}};

/// 0xRRGGBB value of a token in the dark (true) or light (false) appearance.
[[nodiscard]] constexpr foundation::uint32 GetThemeColour(ThemeColour colour, bool isDark) noexcept
{
    const ThemeColourDefinition& definition = THEME_COLOURS[static_cast<foundation::usize>(colour)];
    return isDark == true ? definition.Dark : definition.Light;
}

/// Alpha byte of an opaque 0xAARRGGBB value, as QRgb stores it.
inline constexpr foundation::uint32 OPAQUE_ALPHA = 0xFF000000U;

/// Opaque 0xAARRGGBB value of a token, ready for QColor::fromRgb or QRgb comparisons.
[[nodiscard]] constexpr foundation::uint32 GetThemeArgb(ThemeColour colour, bool isDark) noexcept
{
    return OPAQUE_ALPHA | GetThemeColour(colour, isDark);
}

@design_scale_constants@} // namespace ludus::editor::design
