// Generic smoke-demo shader in LUSL, lowered to Slang and compiled by the SDK helper to SPIR-V
// (Vulkan), WGSL (WebGPU) and GLSL ES 3.00 (WebGL 2). It draws a moving orange marker on a
// pulsing background over a fullscreen triangle, so the demo animates identically on every
// backend through the public rendering API. The marker position comes from the simulation; the
// QA harness detects the orange.
//
// std140 layout (verified independently per target, matching the diagnostic):
//   Resolution float32x2  offset 0  size 8
//   Pulse      float32    offset 8  size 4
//   MarkerSize float32    offset 12 size 4
//   Marker     float32x3  offset 16 size 12   (x, y in [0,1]; z unused)
//   Tint       float32x4  offset 32 size 16
// Total 48 bytes, alignment 16. apps/smoke/renderer_web.cpp mirrors it.
struct SmokeUniforms
{
    float32x2 Resolution;
    float32 Pulse;
    float32 MarkerSize;
    float32x3 Marker;
    float32x4 Tint;
};
ConstantBuffer<SmokeUniforms> smoke;

struct FullscreenVarying
{
    float32x4 Position : ClipPosition;
};

// One triangle covering the target: vertex indices 0, 1, 2 give clip corners (-1, -1), (3, -1),
// (-1, 3). The vertex index lowers to plain VertexIndex / vertex_index / gl_VertexID with no
// base-vertex draw parameters, so the SPIR-V translates to WebGL-safe GLSL ES.
[stage(vertex)]
FullscreenVarying VertexMain(in uint32 vertexIndex : VertexIndex)
{
    float32x2 p = float32x2(float32((vertexIndex << 1) & 2), float32(vertexIndex & 2));
    FullscreenVarying output = { .Position = float32x4(p * 2.0 - 1.0, 0.0, 1.0) };
    return output;
}

[stage(fragment)]
float32x4 FragmentMain(in FullscreenVarying input)
{
    // A fragment reads the ClipPosition field as its pixel position, top-left origin.
    float32x2 positionPixel = input.Position.xy;
#if LUDUS_GLSL_ES
    // WebGL fragment coordinates start at the bottom; the authored scene uses top-left pixels.
    positionPixel.y = smoke.Resolution.y - positionPixel.y;
#endif
    // Pulsing background, independent of marker, so the clear animates.
    float32x3 background = float32x3(0.04 + smoke.Pulse * 0.06, 0.06, 0.14 + smoke.Pulse * 0.08);
    // Marker in framebuffer space; keep it circular regardless of aspect ratio.
    float32x2 uv = positionPixel / smoke.Resolution;
    float32x2 d = (uv - smoke.Marker.xy) * float32x2(smoke.Resolution.x / smoke.Resolution.y, 1.0);
    float32 inside = dot(d, d) < smoke.MarkerSize * smoke.MarkerSize ? 1.0 : 0.0;
    float32x3 color = background + smoke.Tint.rgb * inside;
    return float32x4(color, 1.0);
}
