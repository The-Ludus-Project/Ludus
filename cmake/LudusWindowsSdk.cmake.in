set(Ludus_SDK_CONFIGURATION "@CMAKE_BUILD_TYPE@")
if(NOT WIN32 OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" OR
   NOT CMAKE_CXX_COMPILER_ARCHITECTURE_ID STREQUAL "x64" OR
   NOT CMAKE_CXX_COMPILER_VERSION MATCHES "^19[.]44[.]")
    message(FATAL_ERROR "This Ludus SDK requires Windows x64 with MSVC 14.44. Select the matching compiler and target.")
endif()

# A prefix carries only one library, CRT and generated header configuration.
set(_ludus_allowed_configurations "${Ludus_SDK_CONFIGURATION}")
if(Ludus_SDK_CONFIGURATION MATCHES "^(Development|Profile)$")
    list(APPEND _ludus_allowed_configurations RelWithDebInfo)
endif()
get_property(_ludus_multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
if(_ludus_multi_config)
    set(_ludus_consumer_configurations "${CMAKE_CONFIGURATION_TYPES}")
else()
    set(_ludus_consumer_configurations "${CMAKE_BUILD_TYPE}")
endif()
if(NOT _ludus_consumer_configurations)
    message(FATAL_ERROR "Select one of ${_ludus_allowed_configurations} for the installed Ludus SDK using CMAKE_BUILD_TYPE or CMAKE_CONFIGURATION_TYPES.")
endif()
foreach(_ludus_configuration IN LISTS _ludus_consumer_configurations)
    if(NOT _ludus_configuration IN_LIST _ludus_allowed_configurations)
        message(FATAL_ERROR "The ${Ludus_SDK_CONFIGURATION} Ludus SDK cannot build '${_ludus_configuration}'. Select one of ${_ludus_allowed_configurations} or install the SDK for that configuration.")
    endif()
endforeach()
unset(_ludus_configuration)
unset(_ludus_allowed_configurations)
unset(_ludus_consumer_configurations)
unset(_ludus_multi_config)

include("${CMAKE_CURRENT_LIST_DIR}/LudusD3D12Agility.cmake")

function(ludus_enable_d3d12_agility target_name)
    set(runtime "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/agility")
    ludus_attach_d3d12_agility(${target_name} "@LUDUS_D3D12_AGILITY_SDK_VERSION@"
        "${runtime}" "${runtime}/LICENSE.txt")
endfunction()

function(ludus_configure_windows_sdk_targets)
    string(TOUPPER "@LUDUS_BUILD_FLAVOR@" flavor)
    set_property(TARGET Ludus::FoundationBase APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS "LUDUS_BUILD_${flavor}=1")
    if("@CMAKE_BUILD_TYPE@" MATCHES "^(Development|Profile)$")
        foreach(component IN ITEMS @LUDUS_WINDOWS_SDK_COMPONENTS@)
            set_property(TARGET "Ludus::${component}" PROPERTY MAP_IMPORTED_CONFIG_RELWITHDEBINFO "@CMAKE_BUILD_TYPE@")
        endforeach()
    endif()
endfunction()
