include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/LudusDependencies.cmake")
# No downloads at configure/build time. Host tools remain separate from target
# compilers, including when cross-compiling to wasm.
function(ludus_compile_shader)
    cmake_parse_arguments(PARSE_ARGV 0 SH "RASTER;NATIVE_BINDING_ARRAYS;RUNTIME_BINDING_ARRAYS;NATIVE_RAY_QUERIES;SOFTWARE_RAY_QUERIES;FRAGMENT_STORAGE" "TARGET;NAME;SOURCE;VERTEX;FRAGMENT;COMPUTE" "INCLUDES;DEFINES;DEPENDS")
    if(SH_UNPARSED_ARGUMENTS OR NOT TARGET "${SH_TARGET}" OR
       NOT SH_NAME MATCHES "^[A-Za-z_][A-Za-z_0-9]*$" OR NOT SH_SOURCE OR (NOT SH_COMPUTE AND (NOT SH_VERTEX OR NOT SH_FRAGMENT)) OR (SH_COMPUTE AND (SH_VERTEX OR SH_FRAGMENT OR SH_RASTER)))
        message(FATAL_ERROR "ludus_compile_shader requires TARGET NAME SOURCE and either VERTEX/FRAGMENT or COMPUTE; optional RASTER INCLUDES DEFINES DEPENDS")
    endif()
    ludus_require_tool(LUDUS_SLANG_COMPILER "Shader compilation"
        "From the Ludus source repository root: ./scripts/shader-probe bootstrap" -version)
    set(backend_args)
    if(SH_NATIVE_RAY_QUERIES)
        if(NOT SH_COMPUTE OR EMSCRIPTEN)
            message(FATAL_ERROR "NATIVE_RAY_QUERIES requires native compute; unsupported APIs need an authored raster configuration")
        endif()
        list(APPEND backend_args --native-ray-queries)
    endif()
    if(SH_SOFTWARE_RAY_QUERIES)
        if(NOT SH_COMPUTE OR EMSCRIPTEN OR SH_NATIVE_RAY_QUERIES)
            message(FATAL_ERROR "SOFTWARE_RAY_QUERIES requires native COMPUTE and excludes NATIVE_RAY_QUERIES")
        endif()
        list(APPEND backend_args --graph-software-rays)
    endif()
    set(is_translated_compute FALSE)
    if(SH_NATIVE_RAY_QUERIES OR SH_SOFTWARE_RAY_QUERIES)
        set(is_translated_compute TRUE)
    endif()
    if(SH_RASTER)
        list(APPEND backend_args --raster)
    endif()
    if(SH_FRAGMENT_STORAGE)
        if(NOT SH_RASTER OR SH_COMPUTE)
            message(FATAL_ERROR "FRAGMENT_STORAGE requires RASTER vertex/fragment stages")
        endif()
        list(APPEND backend_args --fragment-storage)
    endif()
    if(SH_NATIVE_BINDING_ARRAYS)
        if((NOT SH_RASTER AND NOT SH_COMPUTE) OR EMSCRIPTEN OR (SH_COMPUTE AND CMAKE_SYSTEM_NAME STREQUAL "Darwin"))
            message(FATAL_ERROR "NATIVE_BINDING_ARRAYS requires native RASTER or Vulkan COMPUTE; provide an authored browser alternative")
        endif()
        list(APPEND backend_args --native-binding-arrays)
    endif()
    if(SH_RUNTIME_BINDING_ARRAYS)
        if(NOT SH_NATIVE_BINDING_ARRAYS OR NOT SH_RASTER OR CMAKE_SYSTEM_NAME STREQUAL "Darwin")
            message(FATAL_ERROR "RUNTIME_BINDING_ARRAYS requires native Vulkan RASTER arrays")
        endif()
        list(APPEND backend_args --runtime-binding-arrays)
    endif()
    set(stage_args --vertex "${SH_VERTEX}" --fragment "${SH_FRAGMENT}")
    set(reflection_byproducts "vertex.reflection.json" "fragment.reflection.json")
    if(SH_COMPUTE)
        set(stage_args --compute "${SH_COMPUTE}")
        set(reflection_byproducts)
    endif()
    set(backend_depends)
    set(backend_byproducts)
    if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
        list(APPEND backend_args --metal)
        list(APPEND backend_byproducts "${SH_NAME}.vertex.metal" "${SH_NAME}.fragment.metal")
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Windows")
        # Direct3D 12 consumes DXIL that the pinned DXC compiles and signs on the
        # Windows host (docs/architecture/windows-direct3d12.md#dxil-artifacts).
        if(SH_COMPUTE OR SH_NATIVE_BINDING_ARRAYS OR SH_FRAGMENT_STORAGE)
            message(FATAL_ERROR "ludus_compile_shader on Windows supports scalar fullscreen and RASTER stages; COMPUTE and arrays need later Direct3D 12 profiles")
        endif()
        if(NOT CMAKE_HOST_WIN32)
            message(FATAL_ERROR "DXIL shader compilation requires a Windows host; cross-compiled Windows builds cannot run the pinned DXC")
        endif()
        foreach(library dxcompiler.dll dxil.dll)
            ludus_require_file("${LUDUS_DXC_DIRECTORY}/${library}" "DXIL shader compilation"
                "On the Windows host, from the Ludus source repository root: python scripts/shader-probe bootstrap\n  Then set LUDUS_DXC_DIRECTORY to out/shader-tools/dxc.")
            list(APPEND backend_depends "${LUDUS_DXC_DIRECTORY}/${library}")
        endforeach()
        list(APPEND backend_args --dxil --dxc-path "${LUDUS_DXC_DIRECTORY}")
        list(APPEND backend_byproducts "${SH_NAME}.vertex.dxil" "${SH_NAME}.fragment.dxil")
    else()
        ludus_require_tool(LUDUS_SPIRV_VALIDATOR "SPIR-V shader validation"
            "On the Linux host, from the Ludus source repository root: ./scripts/shader-probe bootstrap" --version)
        list(APPEND backend_args --validator "${LUDUS_SPIRV_VALIDATOR}")
        list(APPEND backend_depends "${LUDUS_SPIRV_VALIDATOR}")
        list(APPEND backend_byproducts "${SH_NAME}.vertex.spv" "${SH_NAME}.fragment.spv" "${SH_NAME}.wgsl" "wgsl.reflection.json")
    endif()
    if(SH_RASTER AND NOT CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND NOT WIN32)
        list(REMOVE_ITEM backend_byproducts "${SH_NAME}.wgsl" "wgsl.reflection.json")
        list(APPEND backend_byproducts "${SH_NAME}.vertex.wgsl" "${SH_NAME}.fragment.wgsl"
             "vertex.wgsl.reflection.json" "fragment.wgsl.reflection.json")
    endif()
    if(SH_COMPUTE)
        if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
            set(backend_byproducts "${SH_NAME}.compute.metal" "compute.reflection.json")
        elseif(is_translated_compute)
            set(backend_byproducts "${SH_NAME}.compute.spv" "compute.reflection.json")
        else()
            set(backend_byproducts "${SH_NAME}.compute.spv" "${SH_NAME}.compute.wgsl" "compute.reflection.json" "compute.wgsl.reflection.json")
        endif()
    endif()
    ludus_require_python("Shader compilation")
    get_filename_component(source "${SH_SOURCE}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    ludus_require_file("${source}" "Shader compilation" "Restore the shader source or correct SOURCE in ludus_compile_shader.")
    set(output "${CMAKE_CURRENT_BINARY_DIR}/ludus-shaders/${SH_TARGET}/${SH_NAME}")
    # Raster and compute builds define over-long shader text in a compiled companion source
    # rather than a header string literal that C++ compilers need not accept. DXIL headers
    # (Windows) embed binary words only.
    set(companion)
    if((SH_COMPUTE OR SH_RASTER) AND NOT CMAKE_SYSTEM_NAME STREQUAL "Windows")
        set(companion "${output}/${SH_NAME}.cpp")
        set_source_files_properties("${companion}" PROPERTIES GENERATED TRUE)
        target_sources(${SH_TARGET} PRIVATE "${companion}")
    endif()
    list(TRANSFORM backend_byproducts PREPEND "${output}/")
    list(TRANSFORM reflection_byproducts PREPEND "${output}/")
    set(args)
    if(LUDUS_SHADER_WORKER_SOCKET AND (SH_RASTER OR SH_COMPUTE))
        list(APPEND args --worker-socket "${LUDUS_SHADER_WORKER_SOCKET}")
    endif()
    # The source and installed helper expose the same RHI-owned interface vocabulary.
    set(rhi_shader_directory "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/shaders")
    if(NOT EXISTS "${rhi_shader_directory}/raster_bindings.slang")
        set(rhi_shader_directory "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../modules/graphics/rhi/shaders")
    endif()
    list(APPEND args --include "${rhi_shader_directory}")
    foreach(path IN LISTS SH_INCLUDES)
        get_filename_component(path "${path}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        list(APPEND args --include "${path}")
    endforeach()
    foreach(define IN LISTS SH_DEFINES)
        list(APPEND args --define "${define}")
    endforeach()
    set(driver "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/shaders/compile_shader.py")
    set(lock "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/shaders/shader_toolchain.json")
    if(EXISTS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../config/shader_toolchain.json")
        set(lock "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../config/shader_toolchain.json")
    endif()
    # Optional GLSL ES 3.00 (WebGL 2) backend artifact. Enabled only when the
    # pinned SPIR-V -> GLSL ES translator is provided; SPIR-V/WGSL builds are
    # unchanged otherwise. The browser build carries both WGSL and GLSL ES.
    if((is_translated_compute AND CMAKE_SYSTEM_NAME STREQUAL "Darwin") OR (NOT SH_COMPUTE AND NOT SH_FRAGMENT_STORAGE AND (SH_NATIVE_BINDING_ARRAYS OR EMSCRIPTEN OR (LUDUS_SPIRV_CROSS AND NOT CMAKE_SYSTEM_NAME MATCHES "^(Darwin|Windows)$"))))
        ludus_require_tool(LUDUS_SPIRV_CROSS "GLSL ES shader translation"
            "From the Ludus source repository root: ./scripts/bootstrap-spirv-cross")
        ludus_require_file("${LUDUS_SPIRV_CROSS}.build.json" "GLSL ES shader translation"
            "Restore the matching tool provenance: ./scripts/bootstrap-spirv-cross in the Ludus source repository.")
    endif()
    set(cross_args)
    set(cross_depends)
    set(cross_byproducts)
    if(LUDUS_SPIRV_CROSS AND ((is_translated_compute AND CMAKE_SYSTEM_NAME STREQUAL "Darwin") OR (NOT SH_COMPUTE AND NOT SH_FRAGMENT_STORAGE AND (SH_NATIVE_BINDING_ARRAYS OR NOT CMAKE_SYSTEM_NAME MATCHES "^(Darwin|Windows)$"))))
        set(cross_lock "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/shaders/spirv_cross_toolchain.json")
        if(EXISTS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../config/spirv_cross_toolchain.json")
            set(cross_lock "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../config/spirv_cross_toolchain.json")
        endif()
        list(APPEND cross_args --spirv-cross "${LUDUS_SPIRV_CROSS}" --spirv-cross-lock "${cross_lock}")
        list(APPEND cross_depends "${LUDUS_SPIRV_CROSS}" "${LUDUS_SPIRV_CROSS}.build.json" "${cross_lock}")
        list(APPEND cross_byproducts "${output}/${SH_NAME}.vertex.essl" "${output}/${SH_NAME}.fragment.essl")
        if(NOT SH_RASTER)
            list(APPEND cross_byproducts
                "${output}/${SH_NAME}.vertex.glsl-es.spv" "${output}/${SH_NAME}.fragment.glsl-es.spv"
                "${output}/vertex.glsl-es.reflection.json" "${output}/fragment.glsl-es.reflection.json")
        endif()
    endif()
    if(SH_NATIVE_BINDING_ARRAYS)
        set(cross_byproducts)
        set(reflection_byproducts "${output}/vertex.reflection.json" "${output}/fragment.reflection.json")
        set(backend_byproducts "${output}/${SH_NAME}.vertex.spv" "${output}/${SH_NAME}.fragment.spv")
        if(SH_COMPUTE)
            set(reflection_byproducts "${output}/compute.reflection.json")
            set(backend_byproducts "${output}/${SH_NAME}.compute.spv")
        elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
            list(APPEND backend_byproducts "${output}/${SH_NAME}.vertex.metal" "${output}/${SH_NAME}.fragment.metal")
        endif()
    endif()
    if(companion)
        list(APPEND backend_byproducts "${companion}")
    endif()
    set(native_worker_depends)
    if(LUDUS_SHADER_WORKER_SOCKET AND (SH_RASTER OR SH_COMPUTE))
        if(TARGET ludus-shader-worker)
            list(APPEND native_worker_depends ludus-shader-worker)
        elseif(LUDUS_SHADER_WORKER_EXECUTABLE)
            list(APPEND native_worker_depends "${LUDUS_SHADER_WORKER_EXECUTABLE}")
        endif()
    endif()
    add_custom_command(
        OUTPUT "${output}/${SH_NAME}.h"
        BYPRODUCTS ${backend_byproducts} ${reflection_byproducts} "${output}/manifest.json"
                   ${cross_byproducts}
        COMMAND "${Python3_EXECUTABLE}" "${driver}" --source "${source}" --output "${output}"
                --name "${SH_NAME}" ${stage_args}
                --lock "${lock}" --compiler "${LUDUS_SLANG_COMPILER}" ${backend_args} ${cross_args} ${args}
        DEPENDS "${source}" "${driver}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/shaders/compile_raster.py" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/shaders/compile_graph_stage.py" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/shaders/native_worker.py" "${lock}" "${LUDUS_SLANG_COMPILER}" ${backend_depends} ${cross_depends} ${SH_DEPENDS} ${native_worker_depends}
        DEPFILE "${output}/shader.d"
        VERBATIM
    )
    target_sources(${SH_TARGET} PRIVATE "${output}/${SH_NAME}.h")
    target_include_directories(${SH_TARGET} PRIVATE "${output}")
endfunction()

# Fixed native RT0 query artifact. No browser ray shader is implied by this helper.
# The existing verified Slang/SPIRV-Cross pins emit Vulkan 1.2 and MSL 2.4 variants.
function(ludus_compile_ray_queries)
    cmake_parse_arguments(PARSE_ARGV 0 RAY "" "TARGET;NAME" "")
    if(RAY_UNPARSED_ARGUMENTS OR NOT TARGET "${RAY_TARGET}" OR
       NOT RAY_NAME MATCHES "^[A-Za-z_][A-Za-z_0-9]*$")
        message(FATAL_ERROR "ludus_compile_ray_queries requires TARGET and NAME")
    endif()
    ludus_require_tool(LUDUS_SLANG_COMPILER "Native ray shader compilation" "Run ./scripts/shader-probe bootstrap" -version)
    ludus_require_tool(LUDUS_SPIRV_CROSS "Native ray shader translation" "Run ./scripts/bootstrap-spirv-cross")
    ludus_require_file("${LUDUS_SPIRV_CROSS}.build.json" "Native ray shader translation" "Restore the pinned translator provenance.")
    ludus_require_python("Native ray shader compilation")
    set(directory "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/shaders")
    set(lock "${directory}/shader_toolchain.json")
    set(cross_lock "${directory}/spirv_cross_toolchain.json")
    set(source "${directory}/ray_query.slang")
    if(EXISTS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../config/shader_toolchain.json")
        set(lock "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../config/shader_toolchain.json")
        set(cross_lock "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../config/spirv_cross_toolchain.json")
        set(source "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../modules/graphics/rhi/shaders/ray_query.slang")
    endif()
    set(backend_args)
    set(backend_depends)
    if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
        list(APPEND backend_args --metal)
    else()
        ludus_require_tool(LUDUS_SPIRV_VALIDATOR "Native ray SPIR-V validation" "Run ./scripts/shader-probe bootstrap" --version)
        list(APPEND backend_args --validator "${LUDUS_SPIRV_VALIDATOR}")
        list(APPEND backend_depends "${LUDUS_SPIRV_VALIDATOR}")
    endif()
    cmake_path(GET source PARENT_PATH source_directory)
    set(output "${CMAKE_CURRENT_BINARY_DIR}/ludus-shaders/${RAY_TARGET}/${RAY_NAME}")
    add_custom_command(OUTPUT "${output}/${RAY_NAME}.h"
        COMMAND "${Python3_EXECUTABLE}" "${directory}/compile_ray.py" --source "${source}" --output "${output}"
            --name "${RAY_NAME}" --compiler "${LUDUS_SLANG_COMPILER}" --lock "${lock}"
            --spirv-cross "${LUDUS_SPIRV_CROSS}" --spirv-cross-lock "${cross_lock}" ${backend_args}
        DEPENDS "${source}" "${source_directory}/raster_bindings.slang" "${directory}/compile_ray.py" "${directory}/compile_shader.py" "${lock}" "${cross_lock}"
            "${LUDUS_SLANG_COMPILER}" "${LUDUS_SPIRV_CROSS}" "${LUDUS_SPIRV_CROSS}.build.json" ${backend_depends}
        BYPRODUCTS "${output}/${RAY_NAME}.spv" "${output}/${RAY_NAME}.metal" "${output}/manifest.json"
        VERBATIM)
    target_sources("${RAY_TARGET}" PRIVATE "${output}/${RAY_NAME}.h")
    target_include_directories("${RAY_TARGET}" PRIVATE "${output}")
endfunction()

# Cook a bounded raw-texel JSON source into immutable portable upload bytes/mips.
# This performs no downloads and requires only the existing host Python tool.
function(ludus_cook_texture)
    cmake_parse_arguments(PARSE_ARGV 0 TEX "" "TARGET;NAME;SOURCE" "")
    if(TEX_UNPARSED_ARGUMENTS OR NOT TARGET "${TEX_TARGET}" OR
       NOT TEX_NAME MATCHES "^[A-Za-z_][A-Za-z_0-9]*$" OR NOT TEX_SOURCE)
        message(FATAL_ERROR "ludus_cook_texture requires TARGET NAME SOURCE")
    endif()
    get_filename_component(source "${TEX_SOURCE}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    ludus_require_file("${source}" "Texture cooking" "Restore the authored raw-texel source.")
    find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
    set(output "${CMAKE_CURRENT_BINARY_DIR}/ludus-textures/${TEX_TARGET}/${TEX_NAME}")
    set(driver "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/shaders/cook_texture.py")
    add_custom_command(OUTPUT "${output}/${TEX_NAME}.h"
        COMMAND "${Python3_EXECUTABLE}" "${driver}" --source "${source}" --name "${TEX_NAME}" --output "${output}"
        DEPENDS "${source}" "${driver}" BYPRODUCTS "${output}/manifest.json" VERBATIM)
    target_sources("${TEX_TARGET}" PRIVATE "${output}/${TEX_NAME}.h")
    target_include_directories("${TEX_TARGET}" PRIVATE "${output}")
endfunction()

include("${CMAKE_CURRENT_LIST_DIR}/LudusRendererShaders.cmake")
