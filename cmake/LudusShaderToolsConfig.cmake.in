@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/LudusShaderToolsTargets.cmake")
foreach(component IN LISTS LudusShaderTools_FIND_COMPONENTS)
    if(TARGET "Ludus::${component}")
        set("LudusShaderTools_${component}_FOUND" TRUE)
    else()
        set("LudusShaderTools_${component}_FOUND" FALSE)
    endif()
endforeach()
check_required_components(LudusShaderTools)
