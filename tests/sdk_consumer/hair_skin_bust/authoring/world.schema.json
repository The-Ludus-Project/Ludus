{
  "version": 1,
  "id": "ludus.world.hair-skin-bust.v1",
  "label": "Hair and skin bust qualification World",
  "help": "A saved World that imports the static character bust, assigns a skin material to its Skin slot and a hair-card material to its Hair slot, and carries the matched capture camera and the key and fill directional lights. It mirrors the editor's saved bust World ([skin][hair-card]) in a form the installed SDK can reconstruct without the editor.",
  "root": {
    "required": ["version", "schema", "name", "revision", "camera", "slots"],
    "properties": {
      "version": {"type": "integer", "const": 1},
      "schema": {"type": "string", "const": "ludus.world.hair-skin-bust.v1"},
      "name": {"type": "string", "min_bytes": 1, "max_bytes": 1024},
      "revision": {"type": "integer", "min": 1, "help": "Saved World revision recorded in the capture provenance."},
      "description": {"type": "string", "max_bytes": 1024},
      "imports": {"type": "array", "items": "import", "min": 1, "max": 16},
      "camera": {"type": "camera"},
      "lights": {"type": "array", "items": "light", "min": 0, "max": 128},
      "environment": {"type": "environment"},
      "slots": {"type": "array", "items": "slot", "min": 1, "max": 256}
    }
  },
  "types": {
    "import": {
      "required": ["source"],
      "properties": {
        "source": {"type": "path", "help": "glTF source imported into the World, relative to the staged authoring root."},
        "license": {"type": "path", "help": "License notice recorded with the import."}
      }
    },
    "camera": {
      "required": ["eye", "target", "up", "vertical_fov_degrees"],
      "properties": {
        "eye": {"type": "vector3", "unit": "m"},
        "target": {"type": "vector3", "unit": "m"},
        "up": {"type": "vector3"},
        "vertical_fov_degrees": {"type": "number", "min": 1, "max": 179},
        "near": {"type": "number", "min": 0.001, "max": 10000, "default": 0.1},
        "far": {"type": "number", "min": 0.01, "max": 100000, "default": 100}
      }
    },
    "light": {
      "required": ["name", "kind", "direction", "color", "illuminance_lux"],
      "properties": {
        "name": {"type": "string"},
        "kind": {"type": "enum", "choices": ["directional"]},
        "direction": {"type": "vector3", "help": "World-space direction the light travels; normalized on load."},
        "color": {"type": "vector3", "min": 0, "max": 1, "help": "Linear Rec. 709 hue."},
        "illuminance_lux": {"type": "number", "min": 0, "max": 1000000}
      }
    },
    "environment": {
      "required": ["irradiance"],
      "properties": {
        "irradiance": {"type": "vector3", "min": 0, "max": 10000, "help": "Constant diffuse irradiance."},
        "ground_scale": {"type": "number", "min": 0, "max": 1, "default": 1}
      }
    },
    "slot": {
      "required": ["name", "mesh", "material"],
      "properties": {
        "name": {"type": "string", "help": "Imported material slot name: Skin or Hair."},
        "mesh": {"type": "string", "help": "Imported mesh the slot belongs to."},
        "material": {"type": "string", "help": "Material name in bust.scene.json assigned to the slot."},
        "opacity_texture": {"type": "path", "help": "RGBA opacity texture for a masked hair slot."},
        "alpha_cutoff": {"type": "number", "min": 0, "max": 1, "default": 0.5}
      }
    }
  }
}
