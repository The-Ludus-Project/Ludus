{
  "version": 1,
  "id": "RendererStaticBuild",
  "profiles": @RG2_TEST_PROFILES@,
  "schemas": [
    {
      "id": "RendererStatic",
      "role": "Vertex",
      "fields": [
        {
          "id": "PositionMesh",
