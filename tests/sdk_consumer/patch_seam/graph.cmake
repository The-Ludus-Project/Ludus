# Use the authored forward graph's ordinary depth test, scene layout and vertex shader.
function(ludus_compile_patch_seam_graph target forward_source)
    set(staged "${CMAKE_CURRENT_BINARY_DIR}/patch-seam-inputs")
    foreach(file main.lurender.json rasterize.lurender.json main_shaders/geometry.slang)
        configure_file("${forward_source}/${file}" "${staged}/${file}" COPYONLY)
    endforeach()
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/color.slang" "${staged}/main_shaders/color.slang" COPYONLY)
    if(APPLE)
        set(LUDUS_DEFAULT_RENDER_GRAPH_PROFILES "[\"metal\", \"wgsl\"]")
    else()
        set(LUDUS_DEFAULT_RENDER_GRAPH_PROFILES "[\"spirv\", \"wgsl\"]")
    endif()
    configure_file("${forward_source}/main.lushader.json.in" "${staged}/main.lushader.json" @ONLY)
    ludus_compile_render_graph(TARGET ${target} NAME patch_seam MANIFEST "${staged}/main.lushader.json" RUNTIME_PACKAGE)
    target_compile_definitions(${target} PRIVATE "LUDUS_PATCH_SEAM_PACKAGE=\"${patch_seam_RUNTIME_PACKAGE}\"")
    target_sources(${target} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/fixture.cpp")
    target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
    target_link_libraries(${target} PRIVATE Ludus::GeometryContent Ludus::FoundationGeometry Ludus::GraphicsRenderer)
endfunction()
