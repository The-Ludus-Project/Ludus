# Synthetic OBJ/MTL fixture for the Ludus best-effort importer (CC0).
mtllib room.mtl
o Floor
v -2 0 -2
v 2 0 -2
v 2 0 2
v -2 0 2
vt 0 0
vt 4 0
vt 4 4
vt 0 4
vn 0 1 0
usemtl Checker
s off
f 1/1/1 4/4/1 3/3/1 2/2/1
o MirrorWall
v -2 0 -2
v 2 0 -2
v 2 2 -2
v -2 2 -2
usemtl Mirror
f -4 -3 -2 -1
o Light
v -0.5 1.99 -0.5
v 0.5 1.99 -0.5
v 0.5 1.99 0.5
v -0.5 1.99 0.5
usemtl Light
f -4 -3 -2 -1
o Box
g box_top box
usemtl BoxPbr
s 1
v -0.5 0 -0.5
v 0.5 0 -0.5
v 0.5 1 -0.5
v -0.5 1 -0.5
v -0.5 0 0.5
v 0.5 0 0.5
v 0.5 1 0.5
v -0.5 1 0.5
vt 0 0
vt 1 0
vt 1 1
vt 0 1
f -4/-4 -3/-3 -2/-2 -1/-1
f -5/-4 -8/-3 -7/-2 -6/-1
f -8/-4 -4/-3 -1/-2 -7/-1
f -6/-4 -2/-3 -3/-2 -5/-1
f -7/-4 -1/-3 -2/-2 -6/-1
f -5/-4 -3/-3 -4/-2 -8/-1
l 1 2
