// LUSL declarations of FoundationMath's shader library (math.slang), for LUSL modules. Each
// declaration mirrors the Slang one; names and parameter names are unchanged, so named arguments
// use the Slang parameter names. docs/modules/tooling/shader-language.md lists the SDK headers.
#pragma once

@extern "math.slang"
@declare PI FLOAT_EXPONENT_BITS RANDOM_ADDRESS_LAYOUT_VERSION RANDOM_BOUNDED_MAPPING_VERSION
@declare RANDOM_MAX_DIMENSION RANDOM_ATTEMPT_COUNT

/// One addressed draw of the counter-based random generator.
@declare RandomAddress

@declare ComputeErrorFunction IsFiniteBits NormalizeOrZero HasPositiveComponent ComputeArctangent
@declare ComputeStandardNormalQuantile DecodeSrgb MultiplyWide MakeRandomAddress IsRandomAddressInRange
@declare Philox4x32 PackRandomCounter SampleRandomUInt32 RandomFloat01 SampleRandomFloat01
@declare TrySampleRandomBounded ApplyNormalWorld
@end
