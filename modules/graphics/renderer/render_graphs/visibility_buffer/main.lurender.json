{
  "version": 2,
  "id": "Main",
  "default": "Default",
  "configurations": [
    {
      "id": "Default",
      "inputs": [],
      "outputs": [],
      "nodes": [
        {
          "id": "scene",
          "kind": "Scene"
        },
        {
          "active": true,
          "id": "camera",
          "kind": "Camera",
          "role": "Offscreen",
          "target_type": "ColorTexture"
        },
        {
          "extent": "RenderSize",
          "format": "RGBA8Unorm",
          "id": "visibility",
          "imported": false,
          "initialized": false,
          "kind": "Target",
          "presentation": false,
          "samples": 1,
          "type": "ColorTexture"
        },
        {
          "extent": "RenderSize",
          "format": "Depth32Float",
          "id": "depth",
          "imported": false,
          "initialized": false,
          "kind": "Target",
          "presentation": false,
          "samples": 1,
          "type": "DepthTexture"
        },
        {
          "id": "raster",
          "kind": "Subgraph",
          "asset": "library.lurender.json",
          "configuration": "VisibilityBuffer"
        },
        {
          "id": "renderSize",
          "kind": "RenderSize",
          "extent": {
            "reference": "View",
            "scale": [
              1,
              1
            ]
          }
        },
        {
          "id": "visibilityOutput",
          "kind": "Export",
          "type": "ColorTexture"
        },
        {
          "id": "depthOutput",
          "kind": "Export",
          "type": "DepthTexture"
        }
      ],
      "edges": [
        {
          "from": "scene.scene",
          "to": "raster.scene"
        },
        {
          "from": "camera.view",
          "to": "raster.view"
        },
        {
          "from": "visibility.texture",
          "to": "raster.visibility"
        },
        {
          "from": "depth.texture",
          "to": "raster.depth"
        },
        {
          "from": "raster.visibility",
          "to": "visibilityOutput.texture"
        },
        {
          "from": "raster.depth",
          "to": "depthOutput.texture"
        },
        {
          "from": "renderSize.size",
          "to": "visibility.size"
        },
        {
          "from": "renderSize.size",
          "to": "depth.size"
        },
        {
          "from": "visibility.texture",
          "to": "camera.target"
        }
