{
  "version": 1,
  "id": "RendererStaticBuild",
  "profiles": @LUDUS_DEFAULT_RENDER_GRAPH_PROFILES@,
  "schemas": [
    {
      "id": "RendererStatic",
      "role": "Vertex",
      "fields": [
        {
          "id": "PositionMesh",
          "type": "Float3",
          "semantic": "POSITION",
          "location": 0
        },
        {
          "id": "MeshToClipRow0",
          "type": "Float4",
          "semantic": "TEXCOORD0",
          "location": 1
        },
        {
          "id": "MeshToClipRow1",
          "type": "Float4",
          "semantic": "TEXCOORD1",
          "location": 2
        },
        {
          "id": "MeshToClipRow2",
          "type": "Float4",
          "semantic": "TEXCOORD2",
          "location": 3
        },
        {
          "id": "MeshToClipRow3",
          "type": "Float4",
          "semantic": "TEXCOORD3",
          "location": 4
        },
        {
          "id": "Color",
          "type": "Float4",
          "semantic": "COLOR0",
          "location": 5
        }
      ]
    },
    {
      "id": "RasterVarying",
      "role": "Varying",
      "fields": [
        {
          "id": "PositionClip",
          "type": "Float4",
          "semantic": "SV_Position",
          "location": 0
        },
        {
          "id": "Color",
          "type": "Float4",
          "semantic": "COLOR0",
          "location": 0
        }
      ]
    }
  ],
  "programs": [
    {
      "id": "Geometry",
      "stage": "vertex",
      "source": "main_shaders/geometry.slang",
      "function": "TransformGeometry",
      "input": "RendererStatic",
      "output": "RasterVarying",
      "bindings": []
    },
    {
      "id": "Color",
      "stage": "fragment",
      "source": "main_shaders/color.slang",
      "function": "ShadeColor",
      "input": "RasterVarying",
      "output": "Color",
      "bindings": []
    },
    {
      "id": "Depth",
      "stage": "fragment",
      "source": "main_shaders/depth.slang",
      "function": "WriteDepth",
      "input": "RasterVarying",
      "output": "Depth",
      "bindings": []
    },
    {
      "id": "RaoBlackwell",
      "stage": "compute",
      "source": "main_shaders/chain.slang",
      "function": "ShadeRaoBlackwell",
      "input": "RayLaunch",
      "output": "Radiance",
      "bindings": []
    },
    {
      "id": "Standard",
      "stage": "compute",
      "source": "main_shaders/chain.slang",
      "function": "ShadeMetropolis",
      "input": "RayLaunch",
      "output": "Radiance",
      "bindings": []
    },
    {
      "id": "WasteRecycling",
      "stage": "compute",
      "source": "main_shaders/chain.slang",
      "function": "ShadeWasteRecycling",
      "input": "RayLaunch",
      "output": "Radiance",
      "bindings": []
    }
  ],
  "techniques": [
    {
      "id": "DefaultStaticOpaque.ColorAndDepth",
      "configuration": "ColorAndDepth",
      "vertex": "Geometry",
      "fragment": "Color",
      "recipes": [
        {
          "id": "Default",
          "color": "RGBA8Unorm",
          "depth": "Depth32Float",
          "samples": 1,
          "topology": "TriangleList",
          "cull": "None",
          "front": "CounterClockwise",
          "depth_compare": "Less",
          "depth_write": true,
          "blend": "Opaque"
        }
      ]
    },
    {
      "id": "DefaultStaticOpaque.DepthOnly",
      "configuration": "DepthOnly",
      "vertex": "Geometry",
      "fragment": "Depth",
      "recipes": [
        {
          "id": "Default",
          "color": "None",
          "depth": "Depth32Float",
          "samples": 1,
          "topology": "TriangleList",
          "cull": "None",
          "front": "CounterClockwise",
          "depth_compare": "Less",
          "depth_write": true,
          "blend": "Opaque"
        }
      ]
    },
    {
      "id": "RendererTriangles.RayTracing",
      "configuration": "RayTracing",
      "recipes": [
        {
          "id": "Triangles"
        }
      ],
      "scene_interface": {
        "version": 1,
        "surface_queries": 8,
        "visibility_queries": 0
      }
    }
  ],
  "budgets": {
    "configurations": 8,
    "programs": 16
  },
  "settings": [
    {
      "id": "MH_SCATTERING_DEPTH",
      "label": "Maximum BSDF scattering depth",
      "type": "UInt32",
      "value": 3,
      "minimum": 1,
      "maximum": 3
    },
    {
      "id": "MH_BURN_IN",
      "label": "Burn-in proposals (excluded from weighted sums)",
      "type": "UInt32",
      "value": 128,
      "minimum": 0,
      "maximum": 1024
    },
    {
      "id": "MH_LARGE_STEP_PROBABILITY",
      "label": "Independent large-step probability",
      "type": "Float32",
      "value": 0.3,
      "minimum": 0.01,
      "maximum": 1
    },
    {
      "id": "MH_SMALL_STEP_RADIUS",
      "label": "Symmetric primary-space step radius",
      "type": "Float32",
      "value": 0.05,
      "minimum": 0.0001,
      "maximum": 0.5
    },
    {
      "id": "MH_TARGET_FLOOR",
      "label": "Positive target floor (linear radiance)",
      "type": "Float32",
      "value": 1,
      "minimum": 0.0001,
      "maximum": 10000
    }
  ]
}
