{
  "version": 1,
  "id": "RendererStaticBuild",
  "profiles": @LUDUS_DEFAULT_RENDER_GRAPH_PROFILES@,
  "schemas": [
    {
      "id": "RendererStatic",
      "role": "Vertex",
      "fields": [
        {
          "id": "PositionMesh",
          "type": "Float3",
          "semantic": "POSITION",
          "location": 0
        },
        {
          "id": "MeshToClipRow0",
          "type": "Float4",
          "semantic": "TEXCOORD0",
          "location": 1
        },
        {
          "id": "MeshToClipRow1",
          "type": "Float4",
          "semantic": "TEXCOORD1",
          "location": 2
        },
        {
          "id": "MeshToClipRow2",
          "type": "Float4",
          "semantic": "TEXCOORD2",
          "location": 3
        },
        {
          "id": "MeshToClipRow3",
          "type": "Float4",
          "semantic": "TEXCOORD3",
          "location": 4
        },
        {
          "id": "Color",
          "type": "Float4",
          "semantic": "COLOR0",
          "location": 5
        }
      ]
    },
    {
      "id": "RasterVarying",
      "role": "Varying",
      "fields": [
        {
          "id": "PositionClip",
          "type": "Float4",
          "semantic": "SV_Position",
          "location": 0
        },
        {
          "id": "Color",
          "type": "Float4",
          "semantic": "COLOR0",
          "location": 0
        }
      ]
    }
  ],
  "programs": [
    {
      "id": "Geometry",
      "stage": "vertex",
      "source": "main_shaders/geometry.slang",
      "function": "TransformGeometry",
      "input": "RendererStatic",
      "output": "RasterVarying",
      "bindings": []
    },
    {
      "id": "Color",
      "stage": "fragment",
      "source": "main_shaders/color.slang",
      "function": "ShadeColor",
      "input": "RasterVarying",
      "output": "Color",
      "bindings": []
    },
    {
      "id": "Depth",
      "stage": "fragment",
      "source": "main_shaders/depth.slang",
      "function": "WriteDepth",
      "input": "RasterVarying",
      "output": "Depth",
      "bindings": []
    },
    {
      "id": "Miss",
      "stage": "miss",
      "source": "main_shaders/miss.slang",
      "function": "ShadeMiss",
      "input": "Ray",
      "output": "ScenePayload",
      "bindings": []
    },
    {
      "id": "Generate",
      "stage": "ray_generation",
      "source": "main_shaders/generate.slang",
      "function": "GenerateRay",
      "input": "RayLaunch",
      "output": "Radiance",
      "bindings": []
    },
    {
      "id": "InitialClosest",
      "stage": "closest_hit",
      "source": "main_shaders/initial.slang",
      "function": "ShadeClosest",
      "input": "SurfaceHit",
      "output": "ScenePayload",
      "bindings": []
    },
    {
      "id": "TemporalClosest",
      "stage": "closest_hit",
      "source": "main_shaders/temporal.slang",
      "function": "ShadeClosest",
      "input": "SurfaceHit",
      "output": "ScenePayload",
      "bindings": []
    },
    {
      "id": "SpatialClosest",
      "stage": "closest_hit",
      "source": "main_shaders/spatial.slang",
      "function": "ShadeClosest",
      "input": "SurfaceHit",
      "output": "ScenePayload",
      "bindings": []
    }
  ],
  "techniques": [
    {
      "id": "DefaultStaticOpaque.ColorAndDepth",
      "configuration": "ColorAndDepth",
      "vertex": "Geometry",
      "fragment": "Color",
      "recipes": [
        {
          "id": "Default",
          "color": "RGBA8Unorm",
          "depth": "Depth32Float",
          "samples": 1,
          "topology": "TriangleList",
          "cull": "None",
          "front": "CounterClockwise",
          "depth_compare": "Less",
          "depth_write": true,
          "blend": "Opaque"
        }
      ]
    },
    {
      "id": "DefaultStaticOpaque.DepthOnly",
      "configuration": "DepthOnly",
      "vertex": "Geometry",
      "fragment": "Depth",
      "recipes": [
        {
          "id": "Default",
          "color": "None",
          "depth": "Depth32Float",
          "samples": 1,
          "topology": "TriangleList",
          "cull": "None",
          "front": "CounterClockwise",
          "depth_compare": "Less",
          "depth_write": true,
          "blend": "Opaque"
        }
      ]
    },
    {
      "id": "RendererTriangles.RayTracing",
      "configuration": "RayTracing",
      "ray_generation": "Generate",
      "miss": "Miss",
      "closest_hit": "InitialClosest",
      "recipes": [
        {
          "id": "Triangles"
        }
      ],
      "scene_interface": {
        "version": 1,
        "payload": "main_shaders/payload.slang",
        "surface_queries": 1,
        "visibility_queries": 1
      }
    }
  ],
  "budgets": {
    "configurations": 8,
    "programs": 16,
    "artifacts": 64,
    "pipelines": 16
  },
  "settings": [
    {
      "id": "RESTIR_INITIAL_CANDIDATE_COUNT",
      "label": "Initial candidates",
      "type": "UInt32",
      "value": 8,
      "minimum": 1,
      "maximum": 32
    },
    {
      "id": "RESTIR_HISTORY_CANDIDATES",
      "label": "History candidate limit",
      "type": "UInt32",
      "value": 128,
      "minimum": 1,
      "maximum": 1024
    },
    {
      "id": "RESTIR_SPATIAL_NEIGHBOR_COUNT",
      "label": "Spatial neighbours",
      "type": "UInt32",
      "value": 4,
      "minimum": 0,
      "maximum": 4
    },
    {
      "id": "RESTIR_SPATIAL_NORMAL_COSINE",
      "label": "Minimum normal cosine",
      "type": "Float32",
      "value": 0.95,
      "minimum": 0,
      "maximum": 1
    },
    {
      "id": "RESTIR_SPATIAL_DISTANCE_WORLD",
      "label": "Maximum neighbour distance (world units)",
      "type": "Float32",
      "value": 0.25,
      "minimum": 0,
      "maximum": 1000
    },
    {
      "id": "IS_RESTIR_TEMPORAL_ENABLED",
      "label": "Temporal reuse",
      "type": "Bool",
      "value": true
    }
  ]
}
