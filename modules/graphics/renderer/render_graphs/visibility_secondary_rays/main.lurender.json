{
  "version": 2,
  "id": "Main",
  "default": "Default",
  "configurations": [
    {
      "id": "Default",
      "inputs": [],
      "outputs": [],
      "nodes": [
        {
          "id": "scene",
          "kind": "Scene"
        },
        {
          "active": true,
          "id": "camera",
          "kind": "Camera",
          "role": "Offscreen",
          "target_type": "ColorTexture"
        },
        {
          "extent": "RenderSize",
          "format": "RGBA8Unorm",
          "id": "color",
          "imported": false,
          "initialized": false,
          "kind": "Target",
          "presentation": false,
          "samples": 1,
          "type": "ColorTexture"
        },
        {
          "id": "renderSize",
          "kind": "RenderSize",
          "extent": {
            "reference": "View",
            "scale": [
              1,
              1
            ]
          }
        },
        {
          "id": "output",
          "kind": "Export",
          "type": "ColorTexture"
        },
        {
          "id": "visibilityOutput",
          "kind": "Export",
          "type": "ColorTexture"
        },
        {
          "id": "depthOutput",
          "kind": "Export",
          "type": "DepthTexture"
        },
        {
          "id": "transport",
          "kind": "Subgraph",
          "asset": "library.lurender.json",
          "configuration": "VisibilitySecondaryRays"
        }
      ],
      "edges": [
        {
          "from": "scene.scene",
          "to": "transport.scene"
        },
        {
          "from": "camera.view",
          "to": "transport.view"
        },
        {
          "from": "color.texture",
          "to": "transport.color"
        },
        {
          "from": "color.texture",
          "to": "camera.target"
        },
        {
          "from": "renderSize.size",
          "to": "color.size"
        },
        {
          "from": "transport.color",
          "to": "output.texture"
        },
        {
          "from": "transport.visibility",
          "to": "visibilityOutput.texture"
        },
        {
          "from": "transport.depth",
          "to": "depthOutput.texture"
        }
      ]
    }
  ]
}
