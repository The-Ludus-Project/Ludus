{
  "version": 2,
  "id": "SliceSamplingLuminaire",
  "default": "Default",
  "configurations": [
    {
      "id": "Default",
      "inputs": [],
      "outputs": [],
      "nodes": [
        {
          "id": "scene",
          "kind": "Scene"
        },
        {
          "active": true,
          "id": "camera",
          "kind": "Camera",
          "role": "Offscreen",
          "target_type": "ColorTexture"
        },
        {
          "extent": "RenderSize",
          "format": "RGBA8Unorm",
          "id": "color",
          "imported": false,
          "initialized": false,
          "kind": "Target",
          "presentation": false,
          "samples": 1,
          "type": "ColorTexture"
        },
        {
          "id": "renderSize",
          "kind": "RenderSize",
          "extent": {
            "reference": "View",
            "scale": [
              1,
              1
            ]
          }
        },
        {
          "id": "output",
          "kind": "Export",
          "type": "ColorTexture"
        },
        {
          "id": "sliceSamplingOutput",
          "kind": "Export",
          "type": "ColorTexture"
        },
        {
          "id": "uniformAreaOutput",
          "kind": "Export",
          "type": "ColorTexture"
        },
        {
          "id": "transport",
          "kind": "Subgraph",
          "asset": "library.lurender.json",
          "configuration": "SliceSamplingLuminaire"
        },
        {
          "id": "accumulate",
          "kind": "Accumulate",
          "samples": 4096
        },
        {
          "id": "tonemap",
          "kind": "ToneMap",
          "exposure": 1
        },
        {
          "id": "accumulateSliceSampling",
          "kind": "Accumulate",
          "samples": 4096
        },
        {
          "id": "tonemapSliceSampling",
          "kind": "ToneMap",
          "exposure": 1
        },
        {
          "id": "accumulateUniformArea",
          "kind": "Accumulate",
          "samples": 4096
        },
        {
          "id": "tonemapUniformArea",
          "kind": "ToneMap",
          "exposure": 1
        }
      ],
      "edges": [
        {
          "from": "scene.scene",
          "to": "transport.scene"
        },
        {
          "from": "camera.view",
          "to": "transport.view"
        },
        {
          "from": "color.texture",
          "to": "transport.color"
        },
        {
          "from": "color.texture",
          "to": "camera.target"
        },
        {
          "from": "renderSize.size",
          "to": "color.size"
        },
        {
          "from": "transport.color",
          "to": "accumulate.color"
        },
        {
          "from": "accumulate.color",
          "to": "tonemap.color"
        },
        {
          "from": "tonemap.color",
          "to": "output.texture"
        },
        {
          "from": "transport.sliceSampling",
          "to": "accumulateSliceSampling.color"
        },
        {
          "from": "accumulateSliceSampling.color",
          "to": "tonemapSliceSampling.color"
        },
        {
          "from": "tonemapSliceSampling.color",
          "to": "sliceSamplingOutput.texture"
        },
        {
          "from": "transport.uniformArea",
          "to": "accumulateUniformArea.color"
        },
        {
          "from": "accumulateUniformArea.color",
          "to": "tonemapUniformArea.color"
        },
        {
          "from": "tonemapUniformArea.color",
          "to": "uniformAreaOutput.texture"
        }
      ]
    }
  ]
}
