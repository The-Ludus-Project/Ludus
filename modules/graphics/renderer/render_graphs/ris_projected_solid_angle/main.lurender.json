        },
        {
          "from": "accumulateLightSampling.color",
          "to": "tonemapLightSampling.color"
        },
        {
          "from": "tonemapLightSampling.color",
          "to": "lightSamplingOutput.texture"
        },
        {
          "from": "transport.bsdfSampling",
          "to": "accumulateBsdfSampling.color"
        },
        {
          "from": "accumulateBsdfSampling.color",
          "to": "tonemapBsdfSampling.color"
        },
        {
          "from": "tonemapBsdfSampling.color",
          "to": "bsdfSamplingOutput.texture"
        }
      ]
    }
