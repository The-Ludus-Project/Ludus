{
  "version": 1,
  "id": "RendererStaticBuild",
  "profiles": @LUDUS_DEFAULT_RENDER_GRAPH_PROFILES@,
  "schemas": [
    {
      "id": "RendererStatic",
      "role": "Vertex",
      "fields": [
        {
          "id": "PositionMesh",
          "type": "Float3",
          "semantic": "POSITION",
          "location": 0
        },
        {
          "id": "MeshToClipRow0",
          "type": "Float4",
          "semantic": "TEXCOORD0",
          "location": 1
        },
        {
          "id": "MeshToClipRow1",
          "type": "Float4",
          "semantic": "TEXCOORD1",
          "location": 2
        },
        {
          "id": "MeshToClipRow2",
          "type": "Float4",
          "semantic": "TEXCOORD2",
          "location": 3
        },
        {
          "id": "MeshToClipRow3",
          "type": "Float4",
          "semantic": "TEXCOORD3",
          "location": 4
        },
        {
          "id": "Color",
          "type": "Float4",
          "semantic": "COLOR0",
          "location": 5
        }
      ]
    },
    {
      "id": "RasterVarying",
      "role": "Varying",
      "fields": [
        {
          "id": "PositionClip",
          "type": "Float4",
          "semantic": "SV_Position",
          "location": 0
        },
        {
          "id": "Color",
          "type": "Float4",
          "semantic": "COLOR0",
          "location": 0
        }
      ]
    }
  ],
  "programs": [
    {
      "id": "Geometry",
      "stage": "vertex",
      "source": "main_shaders/geometry.slang",
      "function": "TransformGeometry",
      "input": "RendererStatic",
      "output": "RasterVarying",
      "bindings": []
    },
    {
      "id": "Color",
      "stage": "fragment",
      "source": "main_shaders/color.slang",
      "function": "ShadeColor",
      "input": "RasterVarying",
      "output": "Color",
      "bindings": []
    },
    {
      "id": "Depth",
      "stage": "fragment",
      "source": "main_shaders/depth.slang",
      "function": "WriteDepth",
      "input": "RasterVarying",
      "output": "Depth",
      "bindings": []
    },
    {
      "id": "Prepare",
      "stage": "compute",
      "source": "main_shaders/prepare.slang",
      "function": "PrepareGeometrySampling",
      "input": "RayLaunch",
      "output": "Radiance",
      "bindings": []
    },
    {
      "id": "Shade",
      "stage": "compute",
      "source": "main_shaders/shade.slang",
      "function": "ShadeOneMoreVertex",
      "input": "RayLaunch",
      "output": "Radiance",
      "bindings": []
    },
    {
      "id": "GeometryOnly",
      "stage": "compute",
      "source": "main_shaders/shade.slang",
      "function": "ShadeGeometryOnly",
      "input": "RayLaunch",
      "output": "Radiance",
      "bindings": []
    },
    {
      "id": "BsdfOnly",
      "stage": "compute",
      "source": "main_shaders/shade.slang",
      "function": "ShadeBsdfOnly",
      "input": "RayLaunch",
      "output": "Radiance",
      "bindings": []
    }
  ],
  "techniques": [
    {
      "id": "DefaultStaticOpaque.ColorAndDepth",
      "configuration": "ColorAndDepth",
      "vertex": "Geometry",
      "fragment": "Color",
      "recipes": [
        {
          "id": "Default",
          "color": "RGBA8Unorm",
          "depth": "Depth32Float",
          "samples": 1,
          "topology": "TriangleList",
          "cull": "None",
          "front": "CounterClockwise",
          "depth_compare": "Less",
          "depth_write": true,
          "blend": "Opaque"
        }
      ]
    },
    {
      "id": "DefaultStaticOpaque.DepthOnly",
      "configuration": "DepthOnly",
      "vertex": "Geometry",
      "fragment": "Depth",
      "recipes": [
        {
          "id": "Default",
          "color": "None",
          "depth": "Depth32Float",
          "samples": 1,
          "topology": "TriangleList",
          "cull": "None",
          "front": "CounterClockwise",
          "depth_compare": "Less",
          "depth_write": true,
          "blend": "Opaque"
        }
      ]
    },
    {
      "id": "RendererTriangles.RayTracing",
      "configuration": "RayTracing",
      "recipes": [
        {
          "id": "Triangles"
        }
      ],
      "scene_interface": {
        "version": 1,
        "surface_queries": 2,
        "visibility_queries": 4
      }
    }
  ],
  "budgets": {
    "configurations": 8,
    "programs": 16
  },
  "settings": [
    {
      "id": "OMV_DEFENSIVE_WEIGHT",
      "label": "Minimum geometry importance per square world unit",
      "type": "Float32",
      "value": 1e-06,
      "minimum": 1e-09,
      "maximum": 1
    },
    {
      "id": "OMV_FAR_SOLID_ANGLE",
      "label": "One-point geometry proxy below this solid angle (steradians)",
      "type": "Float32",
      "value": 0.1,
      "minimum": 0,
      "maximum": 1
    },
    {
      "id": "OMV_OUTPUT_COMPONENT",
      "label": "Output (0 total, 1 emission, 2 direct, 3 indirect)",
      "type": "UInt32",
      "value": 0,
      "minimum": 0,
      "maximum": 3
    }
  ]
}
