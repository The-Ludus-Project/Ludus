// Linear target composition: top-left UVs, explicit clip-space crop geometry.
// The LUSL compiler assigns the bindings and the vertex input location; the renderer binds them by
// the generated renderer_composite_slots.h constants. A renderer GPU test compares its pixels with
// its Slang original, renderer_composite.slang, which stays as the differential oracle (L5d wave 2).
Texture2D<float32x4> image;
SamplerState imageSampler;

struct CompositeInput
{
    float32x4 PositionUv;
};

struct CompositeVarying
{
    float32x4 Position : ClipPosition;
    float32x2 Uv;
};

[stage(vertex)]
CompositeVarying VertexMain(in CompositeInput input)
{
    CompositeVarying output = { .Position = float32x4(input.PositionUv.xy, 0.0, 1.0), .Uv = input.PositionUv.zw };
    return output;
}

[stage(fragment)]
float32x4 FragmentMain(in CompositeVarying input)
{
    return image.Sample(imageSampler, input.Uv);
}
