// RT1 GPU reference kernels: TraceMain draws one sample for every pixel at the image's minimum committed count and
// ReduceMain folds the per-pixel status. The renderer_reference and renderer_reference_reduce recipes compile this
// file (LUSL L5d wave 2); the transport is in renderer_reference_transport.luslh.
#define LUDUS_REFERENCE_REPEATED_CLOSEST_TRAVERSALS 0
#define LUDUS_REFERENCE_REPEATED_VISIBILITY_TRAVERSALS 0
#define LUDUS_REFERENCE_PERMUTED_PIXELS 0
#define LUDUS_REFERENCE_OPTICAL_CONNECTIONS 0
#include "renderer_reference_transport.luslh"
